# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# survey lead imports & dry-run reports — contain personal emails (PII), never commit
/imports/

# large video source files (mp4 compressed versions are used instead)
public/assets/xyra-day-in-life.mov
public/assets/xyra-day-in-life-2.mov

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
supabase/.temp/
